{
  "name": "lemonade-quote-price-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for the price behaviour of Lemonade's home Quote page",
  "license": "MIT",
  "author": "Pavel Tomarovskii",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "playwright test --project=unit --project=chromium",
    "test:all-browsers": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:coverage": "playwright test --project=chromium --grep @coverage",
    "test:valuable-items": "playwright test --project=chromium --grep @valuable-items",
    "test:add-ons": "playwright test --project=chromium --grep @add-ons",
    "test:deductible": "playwright test --project=chromium --grep @deductible",
    "test:price-display": "playwright test --project=chromium --grep @price-display",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
